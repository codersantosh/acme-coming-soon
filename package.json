{
	"name": "acme-coming-soon",
	"version": "1.0.7",
	"description": "Enable coming soon or maintenance mode by creating a page.",
	"author": "codersantosh",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26",
		"npm": ">=10.9.8"
	},
	"packageManager": "npm@10.9.8",
	"scripts": {
		"build:admin": "node .bin/clean.js && node .bin/prepare-react-shims.js && wp-scripts build src/admin.js --output-path=build/admin",
		"build": "npm run build:admin",
		"start:admin": "wp-scripts start src/admin.js --output-path=build/admin",
		"start": "npm run start:admin",
		"packages-update": "wp-scripts packages-update",
		"lint:js": "wp-scripts lint-js src .bin webpack.config.js",
		"lint:scss": "wp-scripts lint-style 'src/**/*.scss'",
		"test:e2e": "node .github/scripts/admin-smoke.mjs",
		"copy": "node .bin/copy.js",
		"replace": "node .bin/replace-texts.js",
		"normalize-pot": "node .bin/normalize-pot.js",
		"zip": "node .bin/zip.js",
		"makepot": "wp i18n make-pot . languages/acme-coming-soon.pot --skip-js --exclude=build,deploy,tests,.github,vendor,node_modules,src --merge=languages/js.pot",
		"deploy": "npm-run-all build replace makepot normalize-pot copy zip"
	},
	"browserslist": [
		"last 3 versions",
		"> 1%"
	],
	"dependencies": {
		"atrc": "^1.0.37",
		"classnames": "^2.5.1",
		"lodash": "^4.18.1",
		"react-draggable": "^4.7.2",
		"react-icons": "^5.7.0",
		"react-portal": "^4.3.0",
		"react-router-dom": "^6.30.6"
	},
	"devDependencies": {
		"@babel/core": "^7.29.13",
		"@babel/runtime": "^7.29.15",
		"@wordpress/babel-plugin-makepot": "^7.2.0",
		"@wordpress/babel-preset-default": "^10.2.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^7.2.0",
		"@wordpress/element": "^10.2.0",
		"@wordpress/i18n": "^7.2.0",
		"@wordpress/scripts": "37.2.0",
		"archiver": "^8.0.0",
		"autoprefixer": "^10.4.27",
		"npm-run-all": "^4.1.5",
		"playwright": "^1.65.1",
		"prop-types": "^15.8.1",
		"gettext-parser": "^8.0.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"replace-in-file": "^7.1.0"
	},
	"overrides": {
		"@babel/core": "^7.29.13",
		"@babel/helpers": "^7.29.15",
		"@babel/plugin-transform-modules-systemjs": "^7.29.4",
		"@babel/runtime": "^7.29.15",
		"axios": "^1.21.1",
		"brace-expansion@<3": "^2.1.8",
		"cross-spawn": "^7.0.6",
		"fast-uri": "^3.1.9",
		"follow-redirects": "^1.15.11",
		"form-data": "^4.0.6",
		"js-yaml": "^5.5.0",
		"katex": "^0.19.1",
		"lodash": "^4.18.1",
		"lodash-es": "^4.18.1",
		"micromark-extension-math": "^3.1.0",
		"minimatch": "^11.0.1",
		"moment": "^2.31.0",
		"picomatch": "^2.3.2",
		"postcss-selector-parser": "^6.1.5",
		"react": "^19.3.0",
		"react-draggable": "^4.7.2",
		"react-dom": "^19.3.0",
		"react-portal": "^4.3.0",
		"react-router": "^6.30.3",
		"readdir-glob": "^4.0.0",
		"serialize-javascript": "^7.1.3",
		"showdown": "npm:showdown@2.1.0",
		"smol-toml": "^1.9.1",
		"svgo": "^3.3.5",
		"uuid": "^11.1.1",
		"ws": "^7.5.11",
		"yaml": "^1.10.3"
	}
}
